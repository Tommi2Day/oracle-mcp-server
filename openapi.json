{
  "openapi": "3.1.0",
  "info": {
    "title": "Oracle MCP Server",
    "version": "1.0.0",
    "description": "REST API for the Oracle MCP Server. Exposes a health endpoint, MCP Streamable-HTTP transport, and an admin API for token management. Tokens and their optional per-token database connections are stored in a local JSON file (TOKENS_FILE)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local / HTTP"
    },
    {
      "url": "https://localhost:3000",
      "description": "Local / HTTPS"
    }
  ],
  "components": {
    "securitySchemes": {
      "AdminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Value of the AUTH_TOKEN environment variable. Required for /admin/tokens and /mcp."
      },
      "FileToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A file token created via POST /admin/tokens. Grants access to /mcp only. Each file token can optionally route to a different Oracle database."
      },
      "OAuthAdmin": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth 2.0 access token (OAUTH_ISSUER set) of a user whose group/user assignment has admin=true. The admin UI uses a session cookie created by GET /auth/login instead."
      },
      "OAuthUser": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth 2.0 access token for /mcp. Access and default database connection come from the user's group/user assignments."
      }
    },
    "schemas": {
      "TokenConnection": {
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "description": "Per-token Oracle connection. When null the server default connection (ORA_* env vars) is used. The target is chosen by precedence connect_string > tns_alias > host; a token that sets a target never inherits target fields from the default. Credentials fall back to the default only when the token sets no user. password and wallet_password are write-only: responses contain password_set / wallet_password_set instead, and omitting them on PATCH keeps the stored value.",
        "properties": {
          "connect_string": {
            "type": "string",
            "description": "Easy Connect (Plus), full connect descriptor, TNS alias or JDBC URL (jdbc:oracle:thin:@…). Credentials embedded in a JDBC URL are moved to user/password. ?TNS_ADMIN=<dir> is honoured.",
            "example": "jdbc:oracle:thin:@//db.example.com:1521/FREEPDB1"
          },
          "tns_alias": {
            "type": "string",
            "description": "Alias from tnsnames.ora in tns_admin / TNS_ADMIN",
            "example": "PROD_HIGH"
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "default": 1521
          },
          "service_name": {
            "type": "string"
          },
          "sid": {
            "type": "string",
            "description": "Used instead of service_name"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "tcps"
            ],
            "default": "tcp"
          },
          "user": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "tns_admin": {
            "type": "string",
            "description": "Absolute directory (inside the container) with tnsnames.ora / ewallet.pem"
          },
          "wallet_location": {
            "type": "string",
            "description": "Absolute wallet directory (ewallet.pem). A certificate-only ewallet.pem is added to the trusted CAs."
          },
          "wallet_password": {
            "type": "string",
            "writeOnly": true,
            "description": "Password of an encrypted ewallet.pem"
          },
          "ssl_server_dn_match": {
            "type": "boolean",
            "description": "Check the server certificate host name / DN (TCPS, thin mode)"
          },
          "ssl_server_cert_dn": {
            "type": "string",
            "example": "CN=db.example.com"
          },
          "password_set": {
            "type": "boolean",
            "readOnly": true
          },
          "wallet_password_set": {
            "type": "boolean",
            "readOnly": true
          },
          "diagnostics_pack": {
            "type": "boolean",
            "description": "Oracle Diagnostics Pack licensed for this database: enables ash_top / awr_top_events. Default: ORA_DIAGNOSTICS_PACK (false)."
          },
          "tuning_pack": {
            "type": "boolean",
            "description": "Oracle Tuning Pack licensed for this database: enables sql_monitor. Default: ORA_TUNING_PACK (false)."
          }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "connection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TokenConnection"
              },
              {
                "type": "null"
              }
            ],
            "description": "Custom Oracle connection for this token, or null to use the server default."
          },
          "client_connection": {
            "$ref": "#/components/schemas/ClientConnectionMode"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ClientConnectionMode": {
        "type": "string",
        "enum": [
          "none",
          "credentials",
          "full"
        ],
        "default": "none",
        "description": "What MCP clients of this token may set themselves via X-Oracle-* headers on the initialize request: none – nothing (token/server connection only); credentials – X-Oracle-User and X-Oracle-Password; full – additionally the target (X-Oracle-Connect-String, X-Oracle-Tns-Alias, X-Oracle-Host, X-Oracle-Port, X-Oracle-Service-Name, X-Oracle-Sid, X-Oracle-Protocol, X-Oracle-Ssl-Server-Dn-Match, X-Oracle-Ssl-Server-Cert-Dn). A client-supplied target always requires client credentials."
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "integer (admin UI) or env-N (environment, read-only)"
          },
          "group": {
            "type": "string",
            "description": "Group id/name from the groups claim"
          },
          "user": {
            "type": "string",
            "description": "E-mail, or *@domain"
          },
          "connection": {
            "$ref": "#/components/schemas/TokenConnection"
          },
          "client_connection": {
            "type": "string",
            "enum": [
              "none",
              "credentials",
              "full"
            ]
          },
          "admin": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "env",
              "store"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns server status and whether TLS is enabled. No authentication required.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "tls": {
                      "type": "boolean"
                    }
                  }
                },
                "examples": {
                  "default": {
                    "value": {
                      "status": "ok",
                      "tls": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP Streamable-HTTP endpoint",
        "description": "MCP protocol transport. Requires a Bearer token (admin token, file token or, with OAUTH_ISSUER set, an OAuth 2.0 access token; the user's assignment then selects the default connection). When the token has a custom connection configured, that Oracle database is used for this session; otherwise the server default is used. Multi-step protocol: send `initialize` first, then `notifications/initialized`, then tool calls. Include the `mcp-session-id` header returned from `initialize` in subsequent requests. If the token's client_connection permits it, the client may send its own connection parameters as X-Oracle-* headers with the initialize request (see ClientConnectionMode); they apply to the whole session and are re-checked against the token on every request.",
        "operationId": "mcpRequest",
        "security": [
          {
            "AdminToken": []
          },
          {
            "FileToken": []
          },
          {
            "OAuthUser": []
          }
        ],
        "parameters": [
          {
            "name": "mcp-session-id",
            "in": "header",
            "required": false,
            "description": "Session ID returned by the server after initialize. Include in all follow-up requests.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-User",
            "in": "header",
            "required": false,
            "description": "Client-supplied database user (client_connection credentials or full). Requires X-Oracle-Password.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Password",
            "in": "header",
            "required": false,
            "description": "Password for X-Oracle-User. Use HTTPS.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Connect-String",
            "in": "header",
            "required": false,
            "description": "Client-supplied target (client_connection full): Easy Connect, descriptor or JDBC URL. References to wallets / TNS_ADMIN are rejected.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Tns-Alias",
            "in": "header",
            "required": false,
            "description": "Client-supplied target (full): alias from the server's tnsnames.ora.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Host",
            "in": "header",
            "required": false,
            "description": "Client-supplied target (full): host, with X-Oracle-Port, X-Oracle-Service-Name or X-Oracle-Sid, X-Oracle-Protocol (tcp|tcps).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Port",
            "in": "header",
            "required": false,
            "description": "Port for X-Oracle-Host (default 1521).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Service-Name",
            "in": "header",
            "required": false,
            "description": "Service name for X-Oracle-Host.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Sid",
            "in": "header",
            "required": false,
            "description": "SID for X-Oracle-Host (instead of the service name).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Protocol",
            "in": "header",
            "required": false,
            "description": "tcp or tcps for X-Oracle-Host.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Ssl-Server-Dn-Match",
            "in": "header",
            "required": false,
            "description": "true/false: check the server certificate (TCPS).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Oracle-Ssl-Server-Cert-Dn",
            "in": "header",
            "required": false,
            "description": "Expected server certificate DN (TCPS).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jsonrpc": {
                    "type": "string"
                  },
                  "id": {
                    "type": "integer"
                  },
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              },
              "examples": {
                "initialize": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2024-11-05",
                      "capabilities": {},
                      "clientInfo": {
                        "name": "my-client",
                        "version": "1.0"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response (may be plain JSON or text/event-stream SSE)",
            "headers": {
              "mcp-session-id": {
                "description": "Session ID — include in subsequent requests",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid X-Oracle-* header (unknown header, invalid value, user without password, target without credentials); JSON-RPC error body"
          },
          "401": {
            "description": "Missing or invalid Bearer token"
          },
          "403": {
            "description": "X-Oracle-* headers not permitted by the token's client_connection (JSON-RPC error body)"
          },
          "503": {
            "description": "AUTH_TOKEN not configured on the server"
          }
        }
      }
    },
    "/admin/tokens": {
      "get": {
        "summary": "List all tokens",
        "description": "Returns all tokens from the token store. The token_hash field is never included in responses.",
        "operationId": "listTokens",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "responses": {
          "200": {
            "description": "All tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Token"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin token"
          },
          "503": {
            "description": "AUTH_TOKEN not configured on the server"
          }
        }
      },
      "post": {
        "summary": "Create a new token",
        "description": "Creates a new token entry in the token store. The plaintext token is returned once only — only its SHA-256 hash is persisted. An optional `connection` object routes this token to a specific Oracle database; omit it (or set null) to use the server default.",
        "operationId": "createToken",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "connection": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/TokenConnection"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Optional Oracle connection for this token. Omit or set null to use the server default."
                  },
                  "client_connection": {
                    "$ref": "#/components/schemas/ClientConnectionMode"
                  }
                },
                "required": [
                  "name"
                ]
              },
              "examples": {
                "default": {
                  "value": {
                    "name": "claude-desktop"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created — plaintext value shown once",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Token"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "Plaintext token — store securely, not shown again"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "name is missing or blank, or connection is not a valid object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin token"
          },
          "503": {
            "description": "AUTH_TOKEN not configured on the server"
          }
        }
      }
    },
    "/admin/tokens/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "patch": {
        "summary": "Update a token",
        "description": "Updates one or more of name, active, connection or client_connection. At least one field must be provided. Set connection to null to clear a custom connection and fall back to the server default.",
        "operationId": "updateToken",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "active": {
                    "type": "boolean"
                  },
                  "connection": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/TokenConnection"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Set a custom connection, update it, or pass null to clear it."
                  },
                  "client_connection": {
                    "$ref": "#/components/schemas/ClientConnectionMode"
                  }
                }
              },
              "examples": {
                "default": {
                  "value": {
                    "name": "new-name"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated token (token_hash is never returned)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "No valid fields provided, or connection is not a valid object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin token"
          },
          "404": {
            "description": "Token not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_TOKEN not configured on the server"
          }
        }
      },
      "delete": {
        "summary": "Delete a token",
        "description": "Permanently removes the token record from the token store. The token is immediately revoked.",
        "operationId": "deleteToken",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid admin token"
          },
          "404": {
            "description": "Token not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "AUTH_TOKEN not configured on the server"
          }
        }
      }
    },
    "/info": {
      "get": {
        "summary": "Server info",
        "description": "Server name, version and a password-free description of the default Oracle connection. Requires the admin token (AUTH_TOKEN).",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "responses": {
          "200": {
            "description": "Server info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "db": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "connect_string",
                            "tns_alias",
                            "host"
                          ]
                        },
                        "connect_string": {
                          "type": "string"
                        },
                        "host": {
                          "type": "string"
                        },
                        "port": {
                          "type": "integer"
                        },
                        "service_name": {
                          "type": "string"
                        },
                        "sid": {
                          "type": "string"
                        },
                        "tns_alias": {
                          "type": "string"
                        },
                        "protocol": {
                          "type": "string",
                          "enum": [
                            "tcp",
                            "tcps"
                          ]
                        },
                        "user": {
                          "type": "string"
                        },
                        "tns_admin": {
                          "type": "string"
                        },
                        "wallet": {
                          "type": "string"
                        },
                        "driver_mode": {
                          "type": "string",
                          "enum": [
                            "thin",
                            "thick"
                          ]
                        }
                      }
                    },
                    "features": {
                      "type": "object",
                      "description": "Performance tool features of the default connection",
                      "properties": {
                        "perf": {
                          "type": "boolean"
                        },
                        "diagnostics": {
                          "type": "boolean"
                        },
                        "tuning": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/admin/assignments": {
      "get": {
        "summary": "List OAuth assignments",
        "description": "Environment assignments (OAUTH_*, read-only, passwords masked) followed by those stored via the admin UI.",
        "operationId": "listAssignments",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "responses": {
          "200": {
            "description": "Assignments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "assignments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Assignment"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin rights required"
          }
        }
      },
      "post": {
        "summary": "Create an OAuth assignment",
        "description": "Exactly one of group or user. A matching assignment allows the user to use /mcp with the given default connection; admin=true also grants the admin UI/API. Changes apply immediately.",
        "operationId": "createAssignment",
        "security": [
          {
            "AdminToken": []
          },
          {
            "OAuthAdmin": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Assignment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assignment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Admin rights required"
          }
        }
      }
    },
    "/admin/assignments/{id}": {
      "parameters": [
        {
