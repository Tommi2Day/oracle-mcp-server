# oracle-mcp-server — docker-compose / scripts/run.sh environment
# Copy to .env and adjust values before running `docker compose up -d`.

# ── MCP server ────────────────────────────────────────────────────────────────

# Host port the server listens on (container always uses 3000)
MCP_PORT=3000

# Image used by scripts/run.sh (defaults: tommi2day/oracle-mcp-server / latest).
# IMAGE=tommi2day/oracle-mcp-server
# IMAGE_TAG=latest

# Container hostname; added as DNS SAN to the self-signed TLS certificate.
# MCP_HOSTNAME=oracle-mcp-server

# Name shown in MCP clients (e.g. Claude browser tab) and the Admin UI.
# MCP_SERVER_NAME=my-production-db

# Log level: debug | info | warn | error (default: info).
# SQL text of query/execute tool calls is only logged at debug.
# LOG_LEVEL=info

# Admin bearer token for /mcp and /admin/tokens.
# Generate with: openssl rand -hex 32
# Leave empty to disable authentication (development only).
AUTH_TOKEN=

# Encrypts per-token passwords at rest in tokens.json (AES-256-GCM).
# STORE_ENCRYPTION_KEY=

# ── Oracle (default connection) ───────────────────────────────────────────────
# The target is chosen by precedence:
#   1. ORA_CONNECT_STRING – Easy Connect, descriptor, TNS alias or JDBC URL
#   2. ORA_TNS_ALIAS      – alias from $TNS_ADMIN/tnsnames.ora
#   3. ORA_HOST / ORA_PORT / ORA_SERVICE_NAME (or ORA_SID) / ORA_PROTOCOL

# ORA_CONNECT_STRING=jdbc:oracle:thin:@//oracle-test:1521/FREEPDB1
# ORA_TNS_ALIAS=FREE
ORA_HOST=oracle-test
ORA_PORT=1521
ORA_SERVICE_NAME=FREEPDB1
# ORA_SID=
# tcp | tcps
ORA_PROTOCOL=tcp

ORA_USER=mcp
ORA_PASSWORD=mcp_pw
# ORA_PASSWORD_FILE=/run/secrets/ora_password

# ── Oracle client files / TLS (TCPS) ──────────────────────────────────────────
# Host directory with tnsnames.ora, sqlnet.ora, ewallet.pem / cwallet.sso,
# mounted read-only at /opt/oracle/network/admin (= TNS_ADMIN in the container).
# TNS_ADMIN_DIR=./examples/tns_admin

# Wallet directory inside the container (default: TNS_ADMIN if it has ewallet.pem)
# ORA_WALLET_LOCATION=/opt/oracle/network/admin
# Password of an encrypted ewallet.pem
# ORA_WALLET_PASSWORD=
# TCPS server certificate checks (thin mode)
# ORA_SSL_SERVER_DN_MATCH=true
# ORA_SSL_SERVER_CERT_DN=CN=db.example.com
# Additional trusted CA certificates (PEM bundle, path inside the container)
# ORA_TLS_CA_FILE=/opt/oracle/network/admin/ca.pem

# thin (default) | thick (image built with --build-arg ORACLE_THICK=true)
# ORA_DRIVER_MODE=thin

# ── Performance analysis tools ────────────────────────────────────────────────
# explain_plan, sql_plan, top_sql, session_activity, table_stats (no extra licence,
# need SELECT_CATALOG_ROLE or SELECT ANY DICTIONARY). false hides them.
# ORA_PERF_TOOLS=true
# ash_top, awr_top_events – ONLY with an Oracle Diagnostics Pack licence
# ORA_DIAGNOSTICS_PACK=false
# sql_monitor – ONLY with an Oracle Tuning Pack licence
# ORA_TUNING_PACK=false

# Pool / result limits
# ORA_POOL_MAX=5
# ORA_CONNECT_TIMEOUT=10
# ORA_MAX_ROWS=200

# ── TLS (HTTPS) ───────────────────────────────────────────────────────────────

# Set to true to enable HTTPS. Requires a cert volume mounted at /certs.
TLS_ENABLED=false

# Additional SANs for the auto-generated self-signed certificate.
# Example: DNS:myhost.local,IP:192.168.1.10
# TLS_SAN=
