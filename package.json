{
  "name": "oracle-mcp-server",
  "version": "1.0.0",
  "description": "Oracle Database MCP Server for AI tools – stdio & HTTP",
  "license": "MIT",
  "author": "Tommi2Day",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tommi2Day/oracle-mcp-server.git"
  },
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "bin": {
    "oracle-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "TRANSPORT=http node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/oracle.integration.test.ts tests/skills.integration.test.ts tests/oidc.integration.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version": "node --input-type=commonjs -e \"const fs=require('fs'),v=process.env.npm_new_version;const a=JSON.parse(fs.readFileSync('openapi.json'));a.info.version=v;fs.writeFileSync('openapi.json',JSON.stringify(a,null,2)+'\\n');let c=fs.readFileSync('helm/oracle-mcp-server/Chart.yaml','utf8');c=c.replace(/^version: .+/m,'version: '+v).replace(/^appVersion: .+/m,'appVersion: \\\"'+v+'\\\"');fs.writeFileSync('helm/oracle-mcp-server/Chart.yaml',c);\" && git add openapi.json helm/oracle-mcp-server/Chart.yaml",
    "ci:build": "tsc -p tsconfig.build.json",
    "ci:test": "vitest run --coverage --coverage.reporter=text-summary --coverage.reporter=lcov",
    "ci:lint": "eslint .",
    "ci:typecheck": "tsc --noEmit",
    "ci:audit": "npm audit --audit-level=high",
    "audit": "npm audit",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "oracledb": "^26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/oracledb": "^26.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
